# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# Model
OPENAI_API_KEY=REPLACE_ME
OPENAI_API_BASE=https://REPLACE_ME
OPENAI_MODEL=gpt-5
OPENAI_REQUEST_TIMEOUT_SECONDS=7500
OPENAI_MAX_RETRIES=2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Gateway
GATEWAY_AGENT_HTTP_TIMEOUT_SECONDS=600 # One gateway pipeline run should not exceed 10min.
GATEWAY_PORT=8000
GATEWAY_HOST=localhost
GATEWAY_MCP_PORT=8001

# Capability MCP Servers (Standard Range: 9100-9199) 
OSV_MCP_PORT=9100
SYSTEM_MCP_PORT=9101
NOTIFICATION_MCP_PORT=9102
BLOAT_MCP_PORT=9110

# Agents (Standard Range: 9200-9299)
OSV_AGENT_PORT=9200
MATCHER_AGENT_PORT=9201
NOTIFICATION_AGENT_PORT=9202

# Simple Pipeline timeouts (these should be ~ equal!)
SIMPLE_AGENT_RUN_TIMEOUT_SECONDS=1800
SIMPLE_A2A_TIMEOUT_SECONDS=1800

# CrewAI
CREWAI_TRACING_ENABLED=true
